# MongoDB Atlas connection string
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/taskbuddy?retryWrites=true&w=majority
MONGODB_URI=

# A long, random, secret string used to sign JWT tokens
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# Port the backend server will run on
PORT=5000

# Comma-separated list of allowed frontend origins (for CORS)
# Example: http://localhost:5173,https://taskbuddy.vercel.app
CLIENT_URL=http://localhost:5173
